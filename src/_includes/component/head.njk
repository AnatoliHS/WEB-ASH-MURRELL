<head>
  <meta charset="utf-8">
  <script>document.documentElement.classList.add("js");</script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0c0407">
  {% set pageTitle = seoTitle or title or site.title %}
  {% set shareImage = image or "/images/og-logo.png" %}
  {#- Share images only: served from site.shareImageUrl while ashmurrell.com is still on Framer. Remove that line from site.json once the domain moves. #}
  {% set shareImageHost = site.shareImageUrl or site.url %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description | default(site.description) }}">
  <meta name="author" content="{{ site.name }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description | default(site.description) }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ shareImageHost }}{{ shareImage }}">
  {% if not image %}<meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">{% endif %}
  <meta property="og:image:alt" content="{{ pageTitle if image else site.name + ' logo' }}">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ description | default(site.description) }}">
  <meta name="twitter:image" content="{{ shareImageHost }}{{ shareImage }}">

  <!-- Cloudflare Turnstile site key for the contact forms (site.js). Empty: Cloudflare's always-pass test key. -->
  <meta name="turnstile-site-key" content="{{ site.turnstileSiteKey or '1x00000000000000000000AA' }}">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">

  <!-- Structured data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": {{ site.name | dump | safe }},
    "url": {{ site.url | dump | safe }},
    "jobTitle": {{ site.jobTitle | dump | safe }},
    "email": {{ ("mailto:" + site.email) | dump | safe }},
    "sameAs": [
      {{ site.social.youtube | dump | safe }},
      {{ site.social.spotify | dump | safe }},
      {{ site.social.instagram | dump | safe }},
      {{ site.social.linkedin | dump | safe }},
      {{ site.social.substack | dump | safe }}
    ]
  }
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&family=Red+Hat+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/style.css">
  <script src="/site.js" defer></script>
</head>
