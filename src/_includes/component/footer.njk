<footer class="footer">
  <span class="stripes"></span>
  <div class="container">
    <div class="footer-cta">
      <h2 class="footer-title"><span class="mark">Thrive</span> over Survive.</h2>
      <a class="btn btn-primary" href="/contact/">Start a conversation</a>
    </div>
    <div class="footer-grid">
      <nav aria-label="Footer">
        <span class="eyebrow eyebrow-sand">Explore</span>
        {% for item in site.nav %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}
      </nav>
      <nav aria-label="Social">
        <span class="eyebrow eyebrow-sand">Follow</span>
        <a href="{{ site.social.youtube }}">YouTube</a>
        <a href="{{ site.social.spotify }}">Spotify</a>
        <a href="{{ site.social.instagram }}">Instagram</a>
        <a href="{{ site.social.linkedin }}">LinkedIn</a>
        <a href="{{ site.social.substack }}">Substack</a>
      </nav>
      <div class="footer-contact">
        <span class="eyebrow eyebrow-sand">Get in touch</span>
        <a class="footer-email" href="mailto:{{ site.email }}">{{ site.email }}</a>
        <address>{{ site.address }}</address>
      </div>
    </div>
    <p class="footer-legal">© {% year %} {{ site.name }}</p>
  </div>
</footer>
